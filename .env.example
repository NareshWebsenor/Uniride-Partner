# Public app configuration. Never commit production credentials.
BASE_URL_DEV=https://dev-api.example.com
BASE_URL_PROD=https://api.example.com
BUCKET_URL=https://assets.example.com
LOG_LEVEL=debug

# Driver API origin only; the client appends /v1. Production supplied at release.
DRIVER_API_BASE_URL_DEV=https://19sntv0h-3000.inc1.devtunnels.ms
DRIVER_API_BASE_URL_PROD=
UNIRIDE_WORKSPACE=uniride

# Enable Maps SDK for Android; restrict this key to your package/signing SHA-1.
# Leave empty for the illustrative demo map. Rebuild Android after changing it.
GOOGLE_MAP_API_KEY=

# Enable Routes API for road geometry. Separate from the Android Maps SDK key.
GOOGLE_ROUTES_API_KEY=
